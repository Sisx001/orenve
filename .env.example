# ─────────────────────────────────────────────────────────────────────────────
#  ORYNVE v2 — environment
#  Copy to .env (local) or set these in your host's dashboard.
#  Only APP_URL, SESSION_SECRET and the database settings are required.
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the site (no trailing slash). Used for absolute links, cookies,
# payment callbacks and sitemap.
APP_URL=http://localhost:3000

# 32+ random characters. Generate: openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# ── Database ─────────────────────────────────────────────────────────────────
# sqlite (default, zero-setup)  | postgresql | mysql
DATABASE_PROVIDER=sqlite
# sqlite:      file:./data/orynve.db
# postgresql:  postgresql://user:pass@host:5432/orynve?schema=public
# mysql:       mysql://user:pass@host:3306/orynve
DATABASE_URL="file:./data/orynve.db"

# ── First owner account (used by `npm run db:seed`, then ignored) ────────────
SEED_ADMIN_EMAIL=owner@orynve.com
SEED_ADMIN_PASSWORD=ChangeMe!Immediately-2026
SEED_DEMO_DATA=true

# ── Media storage: local | s3 ────────────────────────────────────────────────
MEDIA_STORAGE=local
# For s3 (AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces…)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL for objects (CDN or bucket URL, no trailing slash)
S3_PUBLIC_URL=

# Set to true on hosts without the `sharp` native module (some cPanel plans)
IMAGE_UNOPTIMIZED=false

# ── Payments (all optional; each method also has an on/off switch in the studio)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# ── AI concierge (optional; can also be configured from the studio) ──────────
# Any OpenAI-compatible endpoint: DeepSeek, OpenAI, Groq, Together, OpenRouter,
# Ollama (http://localhost:11434/v1), LM Studio, vLLM…
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# ── Email (optional; order confirmations & password resets) ──────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ORYNVE <hello@orynve.com>"

# ── Deployment ───────────────────────────────────────────────────────────────
# standalone (Docker/Railway/PM2) | server (cPanel Passenger, `next start`) | vercel
DEPLOY_TARGET=standalone
PORT=3000
# Number of reverse proxies in front of the app (Nginx=1, Cloudflare+Nginx=2,
# Vercel/Railway=1). Used to read the real client IP for rate limiting.
TRUSTED_PROXY_HOPS=1

# ── Bangladesh payment gateways (optional; all also configurable in the studio) ──
# bKash Tokenized Checkout (merchant.bka.sh → API)
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Nagad merchant API (RSA keys as single-line base64 or PEM)
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=
# aamarPay
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
# shurjoPay
SHURJOPAY_USERNAME=
SHURJOPAY_PASSWORD=
SHURJOPAY_PREFIX=ORY

# ── Couriers (optional; all also configurable in the studio) ──────────────────
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
REDX_ACCESS_TOKEN=
REDX_PICKUP_STORE_ID=
PAPERFLY_USERNAME=
PAPERFLY_PASSWORD=
PAPERFLY_KEY=

# ── Address auto-detect ─────────────────────────────────────────────────────────
# ipapi (default, https, 1k req/day free) | ip-api (http only)
IP_GEO_PROVIDER=ipapi
