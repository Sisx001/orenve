{
  "name": "orynve",
  "version": "2.0.0",
  "private": true,
  "description": "ORYNVE — premium menswear storefront, owner studio and AI concierge. Single Next.js app that deploys anywhere (Vercel, Railway, VPS, cPanel).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "predev": "node scripts/db-provider.mjs && prisma generate",
    "dev": "next dev",
    "prebuild": "node scripts/db-provider.mjs && prisma generate",
    "build": "next build",
    "postbuild": "node scripts/postbuild.mjs",
    "start": "next start -p ${PORT:-3000}",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:provider": "node scripts/db-provider.mjs",
    "db:push": "node scripts/db-provider.mjs && prisma db push",
    "db:migrate": "node scripts/db-provider.mjs && prisma migrate deploy",
    "db:migrate:dev": "node scripts/db-provider.mjs && prisma migrate dev",
    "db:seed": "node scripts/db-provider.mjs && prisma db seed",
    "db:studio": "prisma studio",
    "db:backup": "node scripts/backup.mjs",
    "setup": "npm run db:push && npm run db:seed",
    "postinstall": "node scripts/db-provider.mjs && prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@prisma/client": "^6.5.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.4.0",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5",
    "sonner": "^2.0.0",
    "stripe": "^17.7.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.20.0",
    "eslint-config-next": "^15.2.0",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "prisma": "^6.5.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
