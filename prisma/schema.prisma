// ORYNVE v2 — data model
// Provider is rewritten by scripts/db-provider.mjs from DATABASE_PROVIDER.
// Portability rules (so SQLite, PostgreSQL and MySQL all work):
//   • no enums  → String columns validated by Zod (see src/lib/constants.ts)
//   • no Json   → String columns holding JSON, parsed by helpers in src/lib/json.ts
//   • money     → Int in minor units (BDT paisa). 1,250.50 BDT = 125050

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Staff & security ─────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("editor") // owner | admin | editor | support
  isActive     Boolean   @default(true)
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  avatarUrl    String?
  locale       String    @default("en")
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions   Session[]
  auditLogs  AuditLog[]
  orderEvents OrderEvent[]
  payments   Payment[]   @relation("VerifiedPayments")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginAttempt {
  key         String   @id // sha256(ip:email)
  count       Int      @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime @updatedAt
}

model RateEvent {
  key         String   @id // sha256(scope:ip)
  count       Int      @default(0)
  windowStart DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      String? // JSON
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

// ───────────────────────────── Catalogue ─────────────────────────────

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String // JSON i18n {"en":"Outerwear","bn":"..."}
  description String? // JSON i18n
  image       String?
  parentId    String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]
}

model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String // JSON i18n
  description String? // JSON i18n
  image       String?
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductCollection[]
}

model Product {
  id             String    @id @default(cuid())
  slug           String    @unique
  sku            String?   @unique
  name           String // JSON i18n
  description    String? // JSON i18n (markdown allowed)
  details        String? // JSON i18n {material, fit, care, shipping, returns}
  status         String    @default("draft") // draft | published | archived
  categoryId     String?
  price          Int // minor units
  compareAtPrice Int?
  costPrice      Int?
  featured       Boolean   @default(false)
  badge          String? // JSON i18n or plain
  tags           String? // JSON string[]
  video          String?
  sizeGuide      String? // JSON {unit, labels[], rows[][], notes}
  seoTitle       String? // JSON i18n
  seoDescription String? // JSON i18n
  sortOrder      Int       @default(0)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  options     ProductOption[]
  variants    ProductVariant[]
  collections ProductCollection[]
  reviews     Review[]
  orderItems  OrderItem[]

  @@index([status, featured])
  @@index([categoryId])
}

model ProductCollection {
  productId    String
  collectionId String
  position     Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model ProductOption {
  id        String @id @default(cuid())
  productId String
  name      String // "Size" | "Color" | custom
  values    String // JSON [{"value":"M"}] or [{"value":"Onyx","hex":"#262521"}]
  position  Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  sku        String? @unique
  title      String // "M / Onyx"
  options    String // JSON {"Size":"M","Color":"Onyx"}
  price      Int? // override product price when set
  stock      Int     @default(0)
  lowStockAt Int     @default(3)
  weightGrams Int?
  imageId    String?
  isActive   Boolean @default(true)
  position   Int     @default(0)

  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  image      ProductImage? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String? // JSON i18n
  colorName String? // links image to a colour option value
  position  Int     @default(0)
  width     Int?
  height    Int?

  product  Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@index([productId])
}

model Review {
  id           String   @id @default(cuid())
  productId    String
  customerName String
  rating       Int
  title        String?
  body         String
  isApproved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isApproved])
}

// ───────────────────────────── Customers & orders ─────────────────────────────

model Customer {
  id        String   @id @default(cuid())
  email     String?  @unique
  phone     String?  @unique
  name      String
  locale    String   @default("en")
  notes     String?
  tags      String? // JSON string[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  addresses Address[]
}

model Address {
  id         String  @id @default(cuid())
  customerId String
  label      String?
  name       String
  phone      String
  line1      String
  line2      String?
  city       String
  district   String
  division   String?
  upazila    String?
  area       String?
  postalCode String?
  country    String  @default("BD")
  lat        Float?
  lng        Float?
  isDefault  Boolean @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Order {
  id              String    @id @default(cuid())
  number          String    @unique // ORY-2026-000123
  trackingCode    String    @unique // short code shared with the customer
  customerId      String?
  status          String    @default("pending") // pending | confirmed | processing | shipped | delivered | cancelled | refunded
  channel         String    @default("website") // website | whatsapp | messenger | manual
  paymentMethod   String    @default("cod") // cod | bkash | nagad | sslcommerz | stripe | none
  paymentStatus   String    @default("unpaid") // unpaid | pending_verification | paid | failed | refunded
  currency        String    @default("BDT")
  exchangeRate    Float     @default(1) // displayed currency per 1 BDT at order time
  subtotal        Int
  discount        Int       @default(0)
  shipping        Int       @default(0)
  codFee          Int       @default(0)
  total           Int
  couponCode      String?
  customerName    String
  email           String?
  phone           String
  shippingAddress String // JSON {line1,line2,city,district,postalCode,country}
  shippingZoneId  String?
  notes           String?
  internalNotes   String?
  courier         String?
  courierTracking String?
  courierUrl      String?
  courierStatus   String? // last raw status from the courier API
  locale          String    @default("en")
  ip              String?
  placedAt        DateTime  @default(now())
  confirmedAt     DateTime?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer  Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items     OrderItem[]
  events    OrderEvent[]
  payments  Payment[]
  shipments Shipment[]

  @@index([status])
  @@index([phone])
  @@index([placedAt])
}

/** A consignment booked with a courier (API or manual). */
model Shipment {
  id             String    @id @default(cuid())
  orderId        String
  provider       String // pathao | steadfast | redx | paperfly | manual
  consignmentId  String? // provider's id
  trackingCode   String? // provider tracking number
  trackingUrl    String?
  status         String    @default("booked") // booked | picked | in_transit | delivered | returned | cancelled | failed
  rawStatus      String?
  codAmount      Int       @default(0)
  deliveryFee    Int?
  weightGrams    Int?
  note           String?
  rawPayload     String? // JSON of last provider response
  lastSyncedAt   DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([provider, consignmentId])
}

/** Studio-added or corrected geography entries merged over the bundled BD dataset. */
model GeoOverride {
  id         String   @id @default(cuid())
  level      String // district | upazila | area | postcode
  parentId   String? // districtId for upazila/area/postcode; divisionId for district
  en         String
  bn         String?
  code       String? // postcode
  lat        Float?
  lng        Float?
  isHidden   Boolean  @default(false) // hide a bundled entry
  targetKey  String? // bundled entry key being hidden/renamed
  createdAt  DateTime @default(now())

  @@index([level, parentId])
}

/** Privacy-friendly first-party analytics (no cookies, hashed IP). */
model Visit {
  id         String   @id @default(cuid())
  day        String // YYYY-MM-DD
  path       String
  locale     String?
  referrer   String?
  utmSource  String?
  utmMedium  String?
  utmCampaign String?
  country    String?
  device     String? // mobile | tablet | desktop | tv | bot
  browser    String?
  ipHash     String // sha256(ip + daily salt)
  visitorKey String // sha256(ipHash + ua) for unique counting
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([day])
  @@index([path])
  @@index([visitorKey])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  productId    String?
  variantId    String?
  name         String
  variantTitle String?
  sku          String?
  image        String?
  unitPrice    Int
  quantity     Int
  total        Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderEvent {
  id          String   @id @default(cuid())
  orderId     String
  type        String // status | payment | shipping | note | message | system
  title       String // JSON i18n or plain
  message     String? // JSON i18n or plain
  isPublic    Boolean  @default(true) // visible to customer / AI concierge
  createdById String?
  createdAt   DateTime @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Payment {
  id            String    @id @default(cuid())
  orderId       String
  method        String // cod | bkash | nagad | sslcommerz | stripe
  provider      String? // manual | sslcommerz | stripe
  amount        Int
  currency      String    @default("BDT")
  status        String    @default("pending") // pending | pending_verification | paid | failed | refunded
  transactionId String? // TrxID / session id
  senderNumber  String? // bKash/Nagad sender wallet
  providerRef   String?
  rawPayload    String? // JSON
  verifiedById  String?
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("VerifiedPayments", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([transactionId])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String // percent | fixed | free_shipping
  value       Int       @default(0) // percent (0-100) or minor units
  minSubtotal Int       @default(0)
  maxUses     Int?
  usedCount   Int       @default(0)
  perCustomer Int?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

model ShippingZone {
  id        String  @id @default(cuid())
  name      String // JSON i18n
  districts String // JSON string[] ("*" = everywhere else)
  rate      Int
  freeAbove Int?
  etaMinDays Int    @default(2)
  etaMaxDays Int    @default(5)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

// ───────────────────────────── Content ─────────────────────────────

model Page {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String // JSON i18n
  body           String // JSON i18n (markdown)
  template       String   @default("editorial") // editorial | plain | legal
  isPublished    Boolean  @default(false)
  showInFooter   Boolean  @default(true)
  seoTitle       String? // JSON i18n
  seoDescription String? // JSON i18n
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Block {
  id        String   @id @default(cuid())
  page      String   @default("home") // home | about | ...
  type      String // hero | featured | editorial | lookbook | arrivals | manifesto | marquee | video | testimonials | newsletter | custom
  position  Int      @default(0)
  isEnabled Boolean  @default(true)
  data      String // JSON (i18n fields inside)
  updatedAt DateTime @updatedAt

  @@index([page, position])
}

model Media {
  id        String   @id @default(cuid())
  url       String
  key       String // storage key / relative path
  name      String
  alt       String?
  mime      String
  size      Int
  width     Int?
  height    Int?
  folder    String   @default("library")
  storage   String   @default("local") // local | s3
  createdAt DateTime @default(now())

  @@index([folder])
}

model Setting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

model Translation {
  id        String @id @default(cuid())
  locale    String
  namespace String @default("common")
  key       String
  value     String

  @@unique([locale, namespace, key])
}

model Subscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  locale      String   @default("en")
  isConfirmed Boolean  @default(true)
  source      String?
  createdAt   DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  status    String   @default("new") // new | replied | archived
  createdAt DateTime @default(now())
}

// ───────────────────────────── AI concierge ─────────────────────────────

model AiConversation {
  id          String   @id @default(cuid())
  sessionKey  String
  locale      String   @default("en")
  messages    String // JSON [{role, content, ts}]
  toolCalls   Int      @default(0)
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  flagged     Boolean  @default(false)
  flagReason  String?
  orderNumber String? // order the visitor verified during the chat
  ip          String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sessionKey])
  @@index([createdAt])
}
